{
  "cleanUrls": true,
  "installCommand": "echo \"Aucune dependance : fonctions sans paquet npm.\"",
  "buildCommand": "echo \"Rien a construire : les pages sont deja fabriquees et commitees.\"",
  "ignoreCommand": "sh scripts/vercel-deployer.sh",
  "functions": {
    "api/feed.js": {
      "includeFiles": "api/feed-data.xml"
    }
  },
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
